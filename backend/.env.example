# Flask
# Use production on Render/Railway/Fly. Production startup fails closed when
# required values below are omitted or demo flags are enabled.
APP_ENV=development
FLASK_ENV=development
PORT=8000
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL / Supabase Postgres (required outside local unit tests)
DATABASE_URL=postgresql://maatrewatch:change-me@localhost:5432/maatriwatch

# Firebase Admin SDK. Prefer an injected service-account JSON string on Render/Railway.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# HTTPS page registered in Firebase Auth's authorised domains. It receives a
# one-time password-reset/activation action link issued by hospital staff.
FIREBASE_AUTH_ACTION_URL=https://your-patient-app.example/activate

# Exact Firebase Hosting / clinician-dashboard origins, comma separated. Leave
# empty outside an explicitly configured web deployment; wildcard origins are
# intentionally not supported for PHI APIs.
CORS_ALLOWED_ORIGINS=https://your-firebase-project-id.web.app

# Hackathon-only mock-role bypass. Keep false outside a local demo environment.
DEMO_MODE=false
DEMO_IN_MEMORY=false

# Device authentication
# Store a bcrypt/argon2 hash in devices.api_key_hash; never store the plaintext key.

# Firebase outbox worker. Start `python -m app.realtime_worker` as a separate
# process in Render/Railway/Fly; it retries RTDB projections after outages.
REALTIME_OUTBOX_POLL_SECONDS=5
REALTIME_OUTBOX_BATCH_SIZE=100
MAX_CONTENT_LENGTH=16384
# A wearable that has not checked in within this duration is a device-health
# issue, not a clinical alert.
DEVICE_OFFLINE_AFTER_MINUTES=30
